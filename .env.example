# .env.example — 키 "이름"만 기록한다. 실제 값은 로컬 .env 에만 둔다.
# 사용법: cp .env.example .env  후 값 입력 (.env 는 .gitignore 대상)

# --- Secrets ---
OPENAI_API_KEY=
DART_API_KEY=
# NAVER API HUB(네이버 클라우드 콘솔) 애플리케이션의 Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Non-secret overrides (비우면 config/settings.yaml 값 사용) ---
LLM_MODEL=
EMBEDDING_MODEL=
DATABASE_PATH=data/database/industry.db
VECTOR_DB_PATH=data/vectordb
